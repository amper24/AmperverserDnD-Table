# Основные настройки теперь в config.yml — он создаётся при первом запуске
# с комментариями ко всем параметрам. Этот файл (.env) нужен, только если
# удобнее задавать настройки переменными окружения: они ПЕРЕКРЫВАЮТ config.yml
# (если в config.yml не выключено env_overrides). Пустое значение = не задано.

# --- База данных ---
# MySQL (рекомендуется для продакшена):
# DATABASE_URL=mysql://dnd:dnd@localhost:3306/dnd
# SQLite (по умолчанию, ничего ставить не нужно):
# DATABASE_URL=sqlite://data/dnd.db

# HOST=0.0.0.0
# PORT=8080

# --- Почта для кодов подтверждения ---
# Без SMTP коды отключены. Только для тестового сервера: явное DEV_SHOW_CODE=true.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_ENCRYPTION=auto   # auto | starttls | tls | none
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# Возвращать код в ответе API, если SMTP не настроен (только для разработки!)
# DEV_SHOW_CODE=true

# --- Регистрация и вход ---
# Кнопка Google скрыта, пока явно не включено (OAuth пока заглушка).
# GOOGLE_AUTH_ENABLED=false
# ALLOW_REGISTRATION=true
# SESSION_DAYS=30
# PASSWORD_MIN_LENGTH=8

# --- Root-аккаунт (создаётся при старте, если его ещё нет) ---
# ROOT_EMAIL=admin@example.com
# ROOT_PASSWORD=

# --- Изображения ---
# IMAGE_QUALITY=82
# MAX_UPLOAD_MB=25

# Уровень логов
# RUST_LOG=info,sqlx=warn

# --- Базовый справочник (SDR / SRD) ---
# Загружать стартовые данные из Git-репозитория при первом запуске (по умолчанию включено).
# Данные НЕ вшиваются в бинарник — скачиваются извне.
# Из репозитория берётся только папка data_seed/ (sparse-checkout): исходники проекта
# в кэш не попадают.
# SDR_ENABLED=true
# SDR_GIT_URL=https://github.com/amper24/AmperverserDnD-Table.git
# SDR_GIT_BRANCH=main
# SDR_CLONE_DIR=.sdr_cache
# Когда забирать данные из Git: once — один раз, если кэша ещё нет (по умолчанию;
# обновление вручную — кнопка «Обновить из Git» на странице /admin), always — при каждом запуске.
# SDR_UPDATE=once
# SDR_LOCAL_PATH=data_seed

# Другой путь к config.yml
# DND_CONFIG=/etc/dnd-table/config.yml
