# Основные настройки теперь в config.yml — он создаётся при первом запуске
# с комментариями ко всем параметрам. Этот файл (.env) нужен, только если
# удобнее задавать настройки переменными окружения: они ПЕРЕКРЫВАЮТ config.yml
# (если в config.yml не выключено env_overrides). Пустое значение = не задано.

# --- База данных ---
# MySQL (рекомендуется для продакшена):
# DATABASE_URL=mysql://dnd:dnd@localhost:3306/dnd
# SQLite (по умолчанию, ничего ставить не нужно):
# DATABASE_URL=sqlite://data/dnd.db

# HOST=0.0.0.0
# PORT=8080

# --- Почта для кодов подтверждения ---
# Если SMTP_HOST пуст, код печатается в консоль сервера (dev-режим).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_ENCRYPTION=auto   # auto | starttls | tls | none
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# Возвращать код в ответе API, если SMTP не настроен (только для разработки!)
# DEV_SHOW_CODE=true

# --- Регистрация и вход ---
# ALLOW_REGISTRATION=true
# SESSION_DAYS=30
# PASSWORD_MIN_LENGTH=8

# --- Root-аккаунт (создаётся при старте, если его ещё нет) ---
# ROOT_EMAIL=admin@example.com
# ROOT_PASSWORD=

# --- Изображения ---
# IMAGE_QUALITY=82
# MAX_UPLOAD_MB=25

# Уровень логов
# RUST_LOG=info,sqlx=warn

# Другой путь к config.yml
# DND_CONFIG=/etc/dnd-table/config.yml
