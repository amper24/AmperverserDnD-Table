# --- База данных ---
# MySQL (рекомендуется):
DATABASE_URL=mysql+aiomysql://dnd:dnd@localhost:3306/dnd
# Или SQLite для быстрого локального запуска:
# DATABASE_URL=sqlite+aiosqlite:///./data/dnd.db

HOST=0.0.0.0
PORT=8080
SECRET_KEY=change-me

# --- Почта для кодов подтверждения ---
# Если SMTP не настроен, код выводится в консоль сервера (dev-режим) и в ответ API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# Показывать код в ответе API (только для разработки!)
DEV_SHOW_CODE=true
